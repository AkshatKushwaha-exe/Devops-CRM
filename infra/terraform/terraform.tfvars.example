# Copy to terraform.tfvars and adjust. Every value shown is the default.
region             = "ap-south-1"
name               = "devops-crm"
kubernetes_version = "1.36"
vpc_cidr           = "10.20.0.0/16"

node_instance_types = ["m7i-flex.large"] # Free Tier eligible (free-plan accounts)
node_ami_type       = "AL2023_x86_64_STANDARD"
node_count          = { desired = 2, min = 2, max = 2 } # new accounts: 5 vCPU quota

# Restrict the public API endpoint to your own IP if you deploy only from your machine:
# cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

github_repository           = "AkshatKushwaha-exe/Devops-CRM"
github_environment          = "production"
create_github_oidc_provider = true # false if the account already has the GitHub OIDC provider
app_namespace               = "crm"

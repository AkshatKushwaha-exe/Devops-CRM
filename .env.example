# Optional overrides for `docker compose`. Copy to .env and change before sharing the host.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_only
CRM_HTTP_PORT=8080
# Run published images instead of building locally, e.g.
# CRM_BACKEND_IMAGE=ghcr.io/akshatkushwaha-exe/devops-crm-backend:<commit-sha>
# CRM_FRONTEND_IMAGE=ghcr.io/akshatkushwaha-exe/devops-crm-frontend:<commit-sha>
